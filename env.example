# Template for the local Docker deployment. Copy to .env and fill in the blanks.
# .env holds real credentials: it is git-ignored and must never be committed.
# Generate a signing key with: openssl rand -base64 48

JWT_SECRET=
JWT_ISSUER=com.example.ktor-sample
JWT_AUDIENCE=com.example.mobile
JWT_REALM=ktor-sample

POSTGRES_DB=ktor_sample
POSTGRES_USER=ktor
POSTGRES_PASSWORD=

# The application reads these three, not the POSTGRES_* pair above. compose.yaml derives them for
# the containerised app, so they matter when the app runs on the host with `./gradlew run`:
# the host reaches Postgres on localhost, not on the compose network name `db`.
# DATABASE_PASSWORD must repeat the POSTGRES_PASSWORD value.
DATABASE_URL=jdbc:postgresql://localhost:5432/ktor_sample
DATABASE_USER=ktor
DATABASE_PASSWORD=

# Host ports. Change either one if something else already listens there.
APP_PORT=8080
POSTGRES_PORT=5432
# Adminer, started by compose.dev.yaml only.
ADMINER_PORT=8081

# Optional. A provider is enabled only when it is configured.
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
CORS_ALLOWED_ORIGINS=
