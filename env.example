# Template for the local Docker deployment. Copy to .env and fill in the blanks.
# .env holds real credentials: it is git-ignored and must never be committed.
# Generate a signing key with: openssl rand -base64 48

JWT_SECRET=
JWT_ISSUER=com.example.ktor-sample
JWT_AUDIENCE=com.example.mobile
JWT_REALM=ktor-sample

POSTGRES_DB=ktor_sample
POSTGRES_USER=ktor
POSTGRES_PASSWORD=

# The application reads these three, not the POSTGRES_* pair above. compose.yaml derives them for
# the containerised app, so they matter when the app runs on the host with `./gradlew run`:
# the host reaches Postgres on localhost, not on the compose network name `db`.
# DATABASE_PASSWORD must repeat the POSTGRES_PASSWORD value.
DATABASE_URL=jdbc:postgresql://localhost:5432/ktor_sample
DATABASE_USER=ktor
DATABASE_PASSWORD=

# The port the server itself binds, on the host with `./gradlew run` and inside the container
# alike; compose passes it through and maps APP_PORT to whatever PORT says.
PORT=8080

# Host ports, published by compose. Change either one if something else already listens there.
# APP_PORT is the host side of the mapping only; PORT above is what the app listens on.
APP_PORT=8080
POSTGRES_PORT=5432
# Adminer, started by compose.dev.yaml only.
ADMINER_PORT=8081

# Optional. A provider is enabled only when it is configured.
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Exact browser origins, comma separated. Each one is scheme + host + port with no trailing
# slash and no path (`http://localhost:5173`); a value without a scheme is treated as https,
# and `localhost` does not match `127.0.0.1`. Empty allows no browser origin at all, which is
# the right setting for a backend only the mobile app calls.
#
# A browser page served from anywhere other than this backend needs its origin listed here, even
# while you develop. A tunnelled front end is the easy one to forget: the origin is the tunnel
# host, not the port it forwards to, so it reads
# `https://<id>-5173.<region>.devtunnels.ms` and has to be listed alongside the plain
# `http://localhost:5173` you use when the tunnel is down.
CORS_ALLOWED_ORIGINS=

# Whether to read the caller's address from X-Forwarded-For instead of the socket. The auth rate
# limiter keys on that address, so behind a proxy every caller otherwise shares one bucket. Only
# safe where a proxy that overwrites the header sits in front — a managed platform does, a local
# run does not, and there the header would just hand a caller unlimited fresh buckets.
TRUST_PROXY_HEADERS=false
